# =============================================================================
# СЕКРЕТНЫЕ КЛЮЧИ - ОБЯЗАТЕЛЬНЫ ДЛЯ РАБОТЫ
# =============================================================================

# Токен HuggingFace
# Получите на https://huggingface.co/settings/tokens
# Требуется для работы pyannote.audio моделей
HF_TOKEN=your_huggingface_token_here

# JWT секретный ключ для аутентификации (если используется)
# Генерируйте безопасный ключ командой: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here

# =============================================================================
# ВСЕ ОСТАЛЬНЫЕ НАСТРОЙКИ НАХОДЯТСЯ В src/config/settings.py
# =============================================================================
# Модели, языки, batch_size и другие параметры теперь настраиваются
# непосредственно в коде в файле settings.py
